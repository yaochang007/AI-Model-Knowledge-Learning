{
  "name": "vue-tech-ai-research-repo-intro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:qwen": "python3.12 -m venv .venv-qwen && .venv-qwen/bin/python -m pip install -U pip qwen-tts soundfile",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.tsx --config=remotion.config.ts",
    "voiceover": ".venv-qwen/bin/python scripts/generate-qwen-voiceover.py",
    "voiceover:qwen": ".venv-qwen/bin/python scripts/generate-qwen-voiceover.py",
    "voiceover:local": "node scripts/generate-voiceover.mjs",
    "render": "node scripts/render-all.mjs",
    "render:covers": "node scripts/render-all.mjs --covers-only",
    "render:videos": "node scripts/render-all.mjs --videos-only"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.463",
    "@remotion/renderer": "^4.0.463",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.463"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
